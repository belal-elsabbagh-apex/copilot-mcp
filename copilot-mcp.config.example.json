    "oauth": { "clientId": "<UiPath external application client id>", "clientSecret": "<UiPath external application client secret>", "tokenUrl": "https://cloud.uipath.com/apexmedicalaiinc/identity_/connect/token (optional, guessed from orchestratorUrl if omitted)" },
    "folderPathByEnv": { "prod": "Authorization", "pre_prod": "Authorization Dev Clone" },
