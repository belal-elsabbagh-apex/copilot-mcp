  "_note": "Copy to copilot-mcp.config.json (gitignored) and point COPILOT_MCP_CONFIG at it. copilot.profiles is the normal path (every Copilot tool takes a required profile arg). Prod now uses support-account auth for every shipped profile below: each prod entry is just { clinicUid } and the credentials come from copilot.support.prod; get the clinicUid from the list_clinics tool. Pre_prod stays on the existing direct per-account login shape. clinicUid wins if both are present. copilot.support is required for prod, and direct prod credentials are no longer shown in this example.",
  "copilot": {
    "sessionCache": true,
    "support": {
      "prod": { "be": "https://prod-be-batch.ehrcopilotbe.com", "email": "<support account email>", "password": "...", "fe": "https://copilot.apexmedical.ai" }
    },
    "profiles": {
      "ossm": { "prod": { "clinicUid": "00000000-0000-0000-0000-000000000000" }, "pre_prod": { "be": "https://pre-prod-be-batch.ehrcopilotbe.com", "email": "...", "password": "...", "fe": "https://pre-prod-copilot.apexmedicalai.com" } },
      "sclc": { "prod": { "clinicUid": "00000000-0000-0000-0000-000000000000" }, "pre_prod": { "be": "https://pre-prod-be-batch.ehrcopilotbe.com", "email": "...", "password": "...", "fe": "https://pre-prod-copilot.apexmedicalai.com" } },
      "kafri": { "prod": { "clinicUid": "00000000-0000-0000-0000-000000000000" }, "pre_prod": { "be": "https://pre-prod-be-batch.ehrcopilotbe.com", "email": "...", "password": "...", "fe": "https://pre-prod-copilot.apexmedicalai.com" } },
      "gateway": { "prod": { "clinicUid": "00000000-0000-0000-0000-000000000000" }, "pre_prod": { "be": "https://pre-prod-be-batch.ehrcopilotbe.com", "email": "...", "password": "...", "fe": "https://pre-prod-copilot.apexmedicalai.com" } }
